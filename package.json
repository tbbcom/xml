{
  "name": "thebukitbesi-blogger-xml",
  "version": "1.0.0",
  "description": "Blogger XML template and validation tools for thebukitbesi.com",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "validate": "node scripts/xml-lint.js",
    "validate:custom": "node scripts/xml-lint.js",
    "lint": "npm run validate",
    "test": "node --test tests/*.js",
    "audit:blogger": "node scripts/blogger-schema-audit.js",
    "cleanup:blogger": "node scripts/blogger-schema-cleanup.js",
    "cleanup:blogger:dry-run": "node scripts/blogger-schema-cleanup.js --max=5"
  },
  "keywords": [
    "blogger",
    "xml",
    "template",
    "validation",
    "thebukitbesi"
  ],
  "author": "The Bukit Besi",
  "license": "MIT",
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "xpath": "^0.0.32"
  }
}
